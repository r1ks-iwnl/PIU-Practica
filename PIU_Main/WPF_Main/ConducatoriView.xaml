<UserControl x:Class="WPF_Main.ConducatoriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<Grid.ColumnDefinitions>
			<!-- Coloana stanga pentru input -->
			<ColumnDefinition MinWidth="220" MaxWidth="350" Width="0.35*"/>
			<!-- Coloana dreapta pentru afisare -->
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="10,10,20,10">
				<TextBlock Text="Nume:" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,2"/>
				<Grid>
					<TextBox x:Name="tbNume" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
							 Text="{Binding NumeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
					<TextBlock Text="Ex. Popescu" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=tbNume}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<TextBlock Text="Prenume:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<Grid>
					<TextBox x:Name="tbPrenume" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
							 Text="{Binding PrenumeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
					<TextBlock Text="Ex. Ion" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=tbPrenume}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<TextBlock Text="Data Naștere:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<DatePicker x:Name="pickDataNastere" HorizontalAlignment="Stretch" MinHeight="24"
							SelectedDate="{Binding DataNastere, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<TextBlock Text="Data Angajare:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<DatePicker x:Name="pickDataAngajare" HorizontalAlignment="Stretch" MinHeight="24"
							SelectedDate="{Binding DataAngajare, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<TextBlock Text="Data expirare permis:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<DatePicker x:Name="pickDataExpirarePermis" HorizontalAlignment="Stretch" MinHeight="24"
						SelectedDate="{Binding DataExpirarePermis, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<Button x:Name="btnAdauga" Style="{StaticResource ActionButton}" Content="Adaugă Conducător" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,20,0,0" Click="btnAdauga_Click"/>
				<Button x:Name="btnModifica" Style="{StaticResource ActionButton}" Content="Modifică Conducător" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="btnModifica_Click"/>
				<Button x:Name="btnSterge" Style="{StaticResource ActionButton}" Content="Șterge Conducător" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="btnSterge_Click"/>

				<TextBlock x:Name="tbMesajStatus" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" TextAlignment="Center"/>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Column="1" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
				<TextBlock Text="Căutare după Nume/Prenume:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBox x:Name="tbCautareNume" Width="200" TextChanged="tbCautareNume_TextChanged"/>
			</StackPanel>

			<Grid Grid.Row="1">
				<DataGrid x:Name="ConducatoriDataGrid" GridLinesVisibility="Horizontal"
					  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ConducatoriDataGrid_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Nume" Binding="{Binding Nume}" />
						<DataGridTextColumn Header="Data Angajare" Binding="{Binding DataAngajare}" />
						<DataGridTextColumn Header="Data expirare permis" Binding="{Binding DataExpirarePermis}" />
						<DataGridTextColumn Header="Data Naștere" Binding="{Binding DataNastere}" />
						<DataGridTextColumn Header="Mașini" Binding="{Binding MasiniConduseDisplay}" />
					</DataGrid.Columns>
				</DataGrid>

				<!-- Empty State Message -->
				<TextBlock Text="Nu a fost găsit niciun conducător." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16" IsHitTestVisible="False">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Items.Count, ElementName=ConducatoriDataGrid}" Value="0">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
