<UserControl x:Class="WPF_Main.MasiniView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition MinWidth="220" MaxWidth="350" Width="0.35*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="10,10,20,10">
				<TextBlock Text="Model:" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,2"/>
				<Grid>
					<TextBox x:Name="Nume" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
							 Text="{Binding ModelText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
							 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
					<TextBlock Text="Ex. Dacia Logan" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=Nume}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>
				<TextBlock Text="An:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<ComboBox x:Name="cmbAn" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"/>
				<TextBlock Text="Număr înmatriculare:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<Grid>
					<TextBox x:Name="tbNumar" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
						 Text="{Binding NumarInmatriculareText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
					<TextBlock Text="Ex. B 12 ABC" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=tbNumar}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>
				<TextBlock Text="Culoare:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
					<RadioButton x:Name="rbRosu" GroupName="rbCuloare" Content="Roșu" Foreground="White" Margin="0,0,10,0"/>
					<RadioButton x:Name="rbAlb" GroupName="rbCuloare" Content="Alb" Foreground="White" Margin="0,0,10,0"/>
					<RadioButton x:Name="rbNegru" GroupName="rbCuloare" Content="Negru" Foreground="White" Margin="0,0,10,0"/>
				</StackPanel>
				<TextBlock Text="Opțiuni:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,5,0,0">
					<CheckBox x:Name="cbAerCond" Content="Aer Conditionat" Foreground="White" Margin="0,0,10,5"/>
					<CheckBox x:Name="cbNavigatie" Content="Navigatie" Foreground="White" Margin="0,0,10,5"/>
					<CheckBox x:Name="cbCutieAutom" Content="Cutie Automata" Foreground="White" Margin="0,0,10,5"/>
					<CheckBox x:Name="cbSenzoriParc" Content="Senzori Parcare" Foreground="White" Margin="0,0,10,5"/>
					<CheckBox x:Name="cbCameraMars" Content="Camera Marșarier" Foreground="White" Margin="0,0,10,5"/>
				</WrapPanel>

				<Button x:Name="Adauga" Style="{StaticResource ActionButton}" Content="Adaugă Mașină" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,20,0,0" Click="Adauga_Click"/>
				<Button x:Name="Modifica" Style="{StaticResource ActionButton}" Content="Modifică Mașină" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="Modifica_Click"/>
				<Button x:Name="Sterge" Style="{StaticResource ActionButton}" Content="Șterge Mașină" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="Sterge_Click"/>
				<TextBlock x:Name="MesajStatus" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" TextAlignment="Center"/>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Column="1" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
				<TextBlock Text="Căutare după Model:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBox x:Name="tbCautareModel" Width="200" TextChanged="tbCautareModel_TextChanged"/>
			</StackPanel>

			<Grid Grid.Row="1">
				<DataGrid x:Name="MasiniDataGrid" GridLinesVisibility="Horizontal"
					  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="MasiniDataGrid_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Model" Binding="{Binding Model}" />
						<DataGridTextColumn Header="An" Binding="{Binding An}" />
						<DataGridTextColumn Header="Culoare" Binding="{Binding Culoare}" />
						<DataGridTextColumn Header="Opțiuni" Binding="{Binding Optiuni}" />
						<DataGridTextColumn Header="Distanță Parcursă" Binding="{Binding DistParcursa}" />
						<DataGridTextColumn Header="Nr. înmatriculare" Binding="{Binding NumarInmatriculare}" />
					</DataGrid.Columns>
				</DataGrid>

				<!-- Empty State Message -->
				<TextBlock Text="Nu a fost găsită nicio mașină." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16" IsHitTestVisible="False">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Items.Count, ElementName=MasiniDataGrid}" Value="0">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
