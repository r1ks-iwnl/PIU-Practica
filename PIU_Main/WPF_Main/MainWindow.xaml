<Window x:Class="WPF_Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Main"
        mc:Ignorable="d"
        Title="Transport" Height="550" Width="900" Background="#393473">
	<Grid>
		<Grid.ColumnDefinitions>
			<!-- Left column for the menu -->
			<ColumnDefinition MinWidth="150" MaxWidth="250" Width="0.25*"/>
			<!-- Right column for the changing views -->
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,10">
			<Button x:Name="btnConducator"
				Style="{StaticResource MDN}"
				Content="Conducatori"
				Margin="0, 0, 0, 20"
                Click="btnConducator_Click"/>
            <Button x:Name="btnMasina"
					Style="{StaticResource MDN}"
					Content="Masini"
					Margin="0, 0, 0, 20"
                    Click="btnMasina_Click"/>
            <Button x:Name="btnCursa"
					Style="{StaticResource MDN}"
					Content="Curse"
					Margin="0, 0, 0, 20"
                    Click="btnCursa_Click"/>
        </StackPanel>

        <!-- The area where your views will be injected -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20" />
    </Grid>
</Window>
