<UserControl x:Class="WPF_Main.CurseView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" Margin="10">
			<TextBlock Text="Masina:" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,2"/>
			<ComboBox x:Name="cmbMasina" Width="200" DisplayMemberPath="Model"/>

			<TextBlock Text="Conducator:" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,2"/>
			<ComboBox x:Name="cmbConducator" Width="200" DisplayMemberPath="Nume"/>

			<TextBlock Text="Distanța:" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,2"/>
			<TextBox x:Name="Distanta" Width="200"/>

			<Button x:Name="Adauga" Content="Adaugă Cursă" Width="200" Margin="0,20,0,0" Click="Adauga_Click"/>
			<TextBlock x:Name="MesajStatus" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" Width="200" TextAlignment="Center"/>
		</StackPanel>

		<DataGrid Grid.Column="1" x:Name="CurseDataGrid" Margin="10" 
				  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Masină" Binding="{Binding Masina.Model}" />
				<DataGridTextColumn Header="Conducător" Binding="{Binding Conducator.Nume}" />
				<DataGridTextColumn Header="Distanță" Binding="{Binding Distanta}" />
				<DataGridTextColumn Header="Stare" Binding="{Binding Stare}" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
