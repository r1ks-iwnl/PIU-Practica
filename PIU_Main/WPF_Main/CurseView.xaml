<UserControl x:Class="WPF_Main.CurseView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition MinWidth="220" MaxWidth="350" Width="0.35*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="10,10,20,10">
				<TextBlock Text="Masina:" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,2"/>
				<ComboBox x:Name="cmbMasina" HorizontalAlignment="Stretch" MinHeight="22" Padding="2" DisplayMemberPath="Model"
						  SelectedItem="{Binding MasinaSelectata, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<TextBlock Text="Conducator:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<ComboBox x:Name="cmbConducator" HorizontalAlignment="Stretch" MinHeight="22" Padding="2" DisplayMemberPath="Nume"
						  SelectedItem="{Binding ConducatorSelectat, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<TextBlock Text="Distanța:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<Grid>
					<TextBox x:Name="Distanta" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
							 Text="{Binding DistantaText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
					<TextBlock Text="Ex. 150" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=Distanta}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<TextBlock Text="Data Start:" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<DatePicker x:Name="pickDataStart" HorizontalAlignment="Stretch" MinHeight="24"
							SelectedDate="{Binding DataStart, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>

				<TextBlock Text="Ora Start (HH:mm) :" Foreground="White" HorizontalAlignment="Left" Margin="0,10,0,2"/>
				<Grid>
					<TextBox x:Name="OraStart" HorizontalAlignment="Stretch" MinHeight="22" Padding="2"
							 Text="{Binding OraStartText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
					<TextBlock Text="Ex. 14:30" Foreground="DarkGray" Margin="7,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=OraStart}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<Button x:Name="Adauga" Style="{StaticResource ActionButton}" Content="Adaugă Cursă" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,20,0,0" Click="Adauga_Click"/>
				<Button x:Name="Modifica" Style="{StaticResource ActionButton}" Content="Modifică Cursă" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="Modifica_Click"/>
				<Button x:Name="Sterge" Style="{StaticResource ActionButton}" Content="Șterge Cursă" HorizontalAlignment="Stretch" MinHeight="30" Margin="0,10,0,0" Click="Sterge_Click"/>
				<TextBlock x:Name="MesajStatus" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" TextAlignment="Center"/>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Column="1" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
				<TextBlock Text="Căutare după Mașină/Șofer:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBox x:Name="tbCautareCursa" Width="200" TextChanged="tbCautareCursa_TextChanged"/>
			</StackPanel>

			<Grid Grid.Row="1">
				<DataGrid x:Name="CurseDataGrid" GridLinesVisibility="Horizontal"
					  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CurseDataGrid_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Masină" Binding="{Binding Masina.Model}" />
						<DataGridTextColumn Header="Conducător" Binding="{Binding Conducator.Nume}" />
						<DataGridTextColumn Header="Distanță" Binding="{Binding Distanta}" />
						<DataGridTextColumn Header="Data de Start" Binding="{Binding DataStart, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
						<DataGridTextColumn Header="Stare" Binding="{Binding Stare}" />
					</DataGrid.Columns>
				</DataGrid>

				<!-- Empty State Message -->
				<TextBlock Text="Nu a fost găsită nicio cursă." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16" IsHitTestVisible="False">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Items.Count, ElementName=CurseDataGrid}" Value="0">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
